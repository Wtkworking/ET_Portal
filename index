<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ET Portal Services</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  
  <style>
    body {
      font-family: 'Prompt', sans-serif;
    }
  </style>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col text-slate-800">

  <header class="bg-gradient-to-r from-blue-700 via-indigo-600 to-violet-700 text-white shadow-lg sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 py-4 sm:py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center space-x-3 text-center sm:text-left">
        <div class="p-2.5 bg-white/10 backdrop-blur-md rounded-2xl border border-white/20 shadow-inner">
          <i data-lucide="layers" class="w-8 h-8 text-blue-200"></i>
        </div>
        <div>
          <h1 class="text-xl sm:text-2xl font-bold tracking-tight">ET Portal Services</h1>
          <p class="text-xs sm:text-sm text-blue-100/90 font-light">ศูนย์รวมระบบและบริการดิจิทัลของคณะวิศวกรรมศาสตร์และเทคโนโลยี PIM</p>
        </div>
      </div>
      
      <div class="flex p-1 bg-white/15 backdrop-blur-md rounded-xl border border-white/20 w-full sm:w-auto">
        <button id="tab-btn-1" onclick="switchTab('guidance')" 
                class="flex-1 sm:flex-initial flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold transition-all duration-200 shadow-sm bg-white text-indigo-700">
          <i data-lucide="compass" class="w-4 h-4"></i>
          <span>งานแนะแนว</span>
        </button>
        <button id="tab-btn-2" onclick="switchTab('faculty')" 
                class="flex-1 sm:flex-initial flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg text-sm font-semibold transition-all duration-200 text-white/90 hover:text-white hover:bg-white/10">
          <i data-lucide="building-2" class="w-4 h-4"></i>
          <span>ส่วนกลางคณะ</span>
        </button>
      </div>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 py-8 flex-1 w-full">
    
    <section id="tab-guidance" class="space-y-6">
      <div class="border-b border-slate-200 pb-3">
        <h2 class="text-xl font-bold text-slate-800 flex items-center gap-2">
          <span class="w-2 h-6 bg-blue-600 rounded-full inline-block"></span>
          บริการระบบงานแนะแนว
        </h2>
        <p class="text-sm text-slate-500 mt-1">เลือกระบบที่ต้องการใช้งานเพื่อเข้าสู่หน้าต่างบริการ</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        
        <div class="group bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover:shadow-xl hover:border-blue-300 transition-all duration-300 flex flex-col justify-between h-full">
          <div class="space-y-3">
            <div class="w-11 h-11 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center group-hover:scale-110 group-hover:bg-blue-600 group-hover:text-white transition-all">
              <i data-lucide="file-plus" class="w-5 h-5"></i>
            </div>
            <div>
              <h3 class="text-base font-bold text-slate-800 group-hover:text-blue-600 transition-colors">สร้างฟอร์มเข้าร่วมกิจกรรม</h3>
              <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">ระบบสำหรับสร้างและจัดการฟอร์มลงทะเบียนเข้าร่วมกิจกรรมแนะแนว</p>
            </div>
          </div>
          <div class="mt-5 pt-3 border-t border-slate-100">
            <a href="https://script.google.com/macros/s/AKfycbyxxfiwU8S6YG8oELi74HYADyjxCVnkYS-J59N9laXNZL7mCnItMUuky96lfzkxGOzxBQ/exec" 
               target="_blank" 
               class="inline-flex items-center justify-center w-full gap-2 px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-xl text-xs transition-colors shadow-md shadow-blue-500/20">
              สร้างแบบฟอร์ม
              <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
            </a>
          </div>
        </div>

        <div class="group bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover:shadow-xl hover:border-indigo-300 transition-all duration-300 flex flex-col justify-between h-full">
          <div class="space-y-3">
            <div class="w-11 h-11 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center group-hover:scale-110 group-hover:bg-indigo-600 group-hover:text-white transition-all">
              <i data-lucide="award" class="w-5 h-5"></i>
            </div>
            <div>
              <h3 class="text-base font-bold text-slate-800 group-hover:text-indigo-600 transition-colors">สมัครสอบชิงทุน</h3>
              <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">ระบบรับสมัครและลงทะเบียนสอบชิงทุนการศึกษาสำหรับนักเรียนและผู้สนใจ</p>
            </div>
          </div>
          <div class="mt-5 pt-3 border-t border-slate-100">
            <a href="https://script.google.com/macros/s/AKfycbyQMrbL_OMOSNbzB6z0Pevp5NUwPPud0ySufU4KL8C52ivHwfIvr7zXD50TJZsgDB6w/exec" 
               target="_blank" 
               class="inline-flex items-center justify-center w-full gap-2 px-3 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-xl text-xs transition-colors shadow-md shadow-indigo-500/20">
              เข้าสู่ระบบ
              <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
            </a>
          </div>
        </div>

        <div class="group bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover:shadow-xl hover:border-violet-300 transition-all duration-300 flex flex-col justify-between h-full">
          <div class="space-y-3">
            <div class="w-11 h-11 rounded-xl bg-violet-50 text-violet-600 flex items-center justify-center group-hover:scale-110 group-hover:bg-violet-600 group-hover:text-white transition-all">
              <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
            </div>
            <div>
              <h3 class="text-base font-bold text-slate-800 group-hover:text-violet-600 transition-colors">ติดตามข้อมูลการจัดกิจกรรม</h3>
              <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">แดชบอร์ดสรุปสถิติ รายงาน และติดตามความคืบหน้าการจัดกิจกรรม</p>
            </div>
          </div>
          <div class="mt-5 pt-3 border-t border-slate-100">
            <a href="https://script.google.com/macros/s/AKfycbyxxfiwU8S6YG8oELi74HYADyjxCVnkYS-J59N9laXNZL7mCnItMUuky96lfzkxGOzxBQ/exec?page=dashboard" 
               class="inline-flex items-center justify-center w-full gap-2 px-3 py-2 bg-violet-600 hover:bg-violet-700 text-white font-medium rounded-xl text-xs transition-colors shadow-md shadow-violet-500/20">
              เปิดหน้าแดชบอร์ด
              <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
            </a>
          </div>
        </div>

        <div class="group relative overflow-hidden bg-gradient-to-br from-[#800713] via-[#b3081e] to-[#dc2626] rounded-2xl p-5 border border-red-900/30 text-white shadow-sm hover:shadow-xl hover:shadow-red-900/30 transition-all duration-300 flex flex-col justify-between h-full">
          <div class="space-y-3 relative z-10">
            <div class="flex items-center justify-between">
              <div class="w-11 h-11 rounded-xl bg-black/25 backdrop-blur-md text-white flex items-center justify-center border border-white/20 group-hover:scale-110 group-hover:bg-white group-hover:text-[#b3081e] transition-all">
                <i data-lucide="tent" class="w-5 h-5"></i>
              </div>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold tracking-wider uppercase bg-black/35 text-white/95 border border-white/15 backdrop-blur-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                Open
              </span>
            </div>
            <div>
              <h3 class="text-base font-bold text-white tracking-wide">ET CAMP 2027 “ค่ายกล คนวิศวะ”</h3>
              <p class="text-xs text-red-100/90 mt-1.5 leading-relaxed font-light">คณะวิศวกรรมศาสตร์และเทคโนโลยี สถาบันการจัดการปัญญาภิวัฒน์ (PIM)</p>
            </div>
          </div>
          <div class="mt-5 pt-3 border-t border-white/15 relative z-10">
            <a href="https://wtkworking.github.io/et-camp-2027/?v=2" 
               target="_blank" 
               class="inline-flex items-center justify-center w-full gap-2 px-3 py-2 bg-white hover:bg-red-50 text-[#990a1c] font-bold rounded-xl text-xs transition-all shadow-md">
              ลงทะเบียนเข้าร่วมค่าย
              <i data-lucide="external-link" class="w-3.5 h-3.5 text-[#990a1c]"></i>
            </a>
          </div>
        </div>

      </div>
    </section>

    <section id="tab-faculty" class="hidden space-y-6">
      <div class="border-b border-slate-200 pb-3">
        <h2 class="text-xl font-bold text-slate-800 flex items-center gap-2">
          <span class="w-2 h-6 bg-emerald-600 rounded-full inline-block"></span>
          บริการระบบส่วนกลางคณะ
        </h2>
        <p class="text-sm text-slate-500 mt-1">เครื่องมือและระบบอำนวยความสะดวกสำหรับบุคลากรและนักศึกษา</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="group bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm hover:shadow-xl hover:border-emerald-300 transition-all duration-300 flex flex-col justify-between h-full">
          <div class="space-y-3">
            <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center group-hover:scale-110 group-hover:bg-emerald-600 group-hover:text-white transition-all">
              <i data-lucide="qr-code" class="w-5 h-5"></i>
            </div>
            <div>
              <h3 class="text-base font-bold text-slate-800 group-hover:text-emerald-600 transition-colors">ET QR Code Generator</h3>
              <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">เครื่องมือสร้างรหัส QR Code สำหรับลิงก์ เอกสาร และสื่อประชาสัมพันธ์ของคณะ</p>
            </div>
          </div>
          <div class="mt-5 pt-3 border-t border-slate-100">
            <a href="https://qr-code-generator-nu-drab.vercel.app" 
               target="_blank" 
               class="inline-flex items-center justify-center w-full gap-2 px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-medium rounded-xl text-xs transition-colors shadow-md shadow-emerald-500/20">
              สร้าง QR Code
              <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <footer class="bg-white border-t border-slate-200 py-6 text-center text-xs text-slate-400">
    <p>© 2026 ET Portal Services. All rights reserved.</p>
  </footer>

  <script>
    // Initialize Lucide Icons
    lucide.createIcons();

    function switchTab(tab) {
      const guidanceSection = document.getElementById('tab-guidance');
      const facultySection = document.getElementById('tab-faculty');
      const btn1 = document.getElementById('tab-btn-1');
      const btn2 = document.getElementById('tab-btn-2');

      const activeClass = ['bg-white', 'text-indigo-700', 'shadow-sm'];
      const inactiveClass = ['text-white/90', 'hover:text-white', 'hover:bg-white/10'];

      if (tab === 'guidance') {
        guidanceSection.classList.remove('hidden');
        facultySection.classList.add('hidden');

        btn1.classList.add(...activeClass);
        btn1.classList.remove(...inactiveClass);

        btn2.classList.remove(...activeClass);
        btn2.classList.add(...inactiveClass);
      } else {
        guidanceSection.classList.add('hidden');
        facultySection.classList.remove('hidden');

        btn2.classList.add(...activeClass);
        btn2.classList.remove(...inactiveClass);

        btn1.classList.remove(...activeClass);
        btn1.classList.add(...inactiveClass);
      }
    }
  </script>
</body>
</html>
